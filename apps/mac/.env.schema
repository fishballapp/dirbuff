# DirBuff release: environment schema (varlock + 1Password).
#
# Every value lives in 1Password, and nowhere else: the team's Developer ID certificate and App Store
# Connect key in `native-mac-app-shared`, which every Mac app's release reads, and DirBuff's own in
# `dirbuff-release`. Locally they resolve through the 1Password desktop app; in the release workflow
# through the one GitHub secret, DIRBUFF_OP_TOKEN, a service account that can read those two
# Environments only.
#
# @defaultRequired=true
# @defaultSensitive=true
# @plugin(@varlock/1password-plugin)
# @initOp(token=$DIRBUFF_OP_TOKEN, allowAppAuth=true, cacheTtl=1d)
# @setValuesBulk(opLoadEnvironment(ykljsst56zqg63ohl63nwaxu4q))
# @setValuesBulk(opLoadEnvironment(yd62ixhx7enhlidfx64p6uk5aa))
# ---

# @type=opServiceAccountToken @required=false
DIRBUFF_OP_TOKEN=

# Developer ID Application certificate (base64 .p12) and its password, for code signing.
MAC_NATIVE_APP_APPLE_CERTIFICATE=
MAC_NATIVE_APP_APPLE_CERTIFICATE_PASSWORD=

# App Store Connect API key, for notarytool.
ASC_API_KEY_P8_BASE64=
# @sensitive=false
ASC_KEY_ID=
# @sensitive=false
ASC_ISSUER_ID=

# Sparkle 2 EdDSA private key (base64 32-byte seed), piped to sign_update.
SPARKLE_PRIVATE_KEY=

# Cloudflare R2 S3-compatible credentials scoped to the bucket dirbuff-releases.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
