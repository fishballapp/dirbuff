# DirBuff release and signed local build: environment schema (varlock + 1Password).
#
# Every value lives in 1Password, and nowhere else: the team's Developer ID certificate and App Store
# Connect key in `native-mac-app-shared`, which every Mac app's release reads, and DirBuff's own in
# `dirbuff-release`. Locally they resolve through the 1Password desktop app; in the release workflow
# through the one GitHub secret, DIRBUFF_OP_TOKEN, a service account that can read those two
# Environments only.
#
# The release loads everything. A signed local build (`pnpm -F @dirbuff/mac with-secrets --
# ./build.sh`) leaves out the items tagged #release, so it sees the certificate alone.
#
# @defaultRequired=true
# @defaultSensitive=true
# @plugin(@varlock/1password-plugin)
# @initOp(token=$DIRBUFF_OP_TOKEN, allowAppAuth=true, cacheTtl=1d)
# @setValuesBulk(opLoadEnvironment(ykljsst56zqg63ohl63nwaxu4q))
# @setValuesBulk(opLoadEnvironment(yd62ixhx7enhlidfx64p6uk5aa))
# ---

# @type=opServiceAccountToken @required=false
DIRBUFF_OP_TOKEN=

# Developer ID Application certificate (base64 .p12) and its password, for code signing. Each build
# imports it into a throwaway keychain (release.yml's in CI, signing-keychain.sh's for build.sh);
# no keychain keeps a copy.
MAC_NATIVE_APP_APPLE_CERTIFICATE=
MAC_NATIVE_APP_APPLE_CERTIFICATE_PASSWORD=

# App Store Connect API key, for notarytool.
# @tag(release)
ASC_API_KEY_P8_BASE64=
# @tag(release) @sensitive=false
ASC_KEY_ID=
# @tag(release) @sensitive=false
ASC_ISSUER_ID=

# Sparkle 2 EdDSA private key (base64 32-byte seed), piped to sign_update.
# @tag(release)
SPARKLE_PRIVATE_KEY=

# The Google OAuth client secret of "DirBuff for Mac" (project fishball-dirbuff), which Backup signs
# in to Drive with. Google treats a desktop client's secret as public; it lives here so the source
# doesn't carry it.
GOOGLE_OAUTH_CLIENT_SECRET=
