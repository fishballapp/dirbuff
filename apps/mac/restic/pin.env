# The restic that ships inside DirBuff.app, and the only place its version is written.
# build.sh builds exactly this source release. To upgrade: change both lines, then run the
# runner's tests (packages/kit) against the new build. SHA256 is the release's own
# `restic-<version>.tar.gz` entry in its SHA256SUMS.
RESTIC_VERSION=0.19.1
RESTIC_SOURCE_SHA256=bb9b1a19040744d26d8a79be029d4e6b189c45ccc9d8831d7fe367d3c33df725
