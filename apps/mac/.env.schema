# DirBuff release and signed local build: environment schema (varlock + baymutt).
#
# Every value lives in baymutt, and nowhere else: the team's Developer ID certificate in
# `fishball-ltd/apple/developer-id` and App Store Connect key in `fishball-ltd/apple/app-store-connect`
# (both shared with the other Mac app), and DirBuff's own in `fishball-ltd/dirbuff/release`. The
# release workflow gets them through the one GitHub secret, BAYMUTT_KEY, a service account that reads
# those three environments only.
#
# The release loads everything. A signed local build (`pnpm -F @dirbuff/mac with-secrets --
# ./build.sh`) leaves out the items tagged #release, so it sees the certificate alone, but the schema
# still loads all three environments, so the key must read all three. A CLI login holds none, so ask
# the owner for a key, then name its file:
#
#   baymutt ask access --read fishball-ltd/apple/developer-id \
#     --read fishball-ltd/apple/app-store-connect --read fishball-ltd/dirbuff/release \
#     --reason "<why>" --expires 1h
#   baymutt ask wait <id>          # approved: prints the key file's path
#   BAYMUTT_KEY_FILE=<path> pnpm -F @dirbuff/mac with-secrets -- ./build.sh
#
# Nothing is cached: every run fetches all three environments.
#
# @defaultRequired=true
# @defaultSensitive=true
# @plugin(@baymutt/varlock-plugin)
# @initBaymutt(key=$BAYMUTT_KEY)
# @setValuesBulk(baymuttLoad("fishball-ltd/apple/developer-id"))
# @setValuesBulk(baymuttLoad("fishball-ltd/apple/app-store-connect"))
# @setValuesBulk(baymuttLoad("fishball-ltd/dirbuff/release"))
# ---

# A key that reads the three environments, when it is handed over as a value (CI). Unset where
# BAYMUTT_KEY_FILE names the key file `baymutt ask wait` printed.
# @required=false
BAYMUTT_KEY=

# Developer ID Application certificate (base64 .p12) and its password, for code signing. Each build
# imports it into a throwaway keychain (release.yml's in CI, signing-keychain.sh's for build.sh);
# no keychain keeps a copy.
MAC_NATIVE_APP_APPLE_CERTIFICATE=
MAC_NATIVE_APP_APPLE_CERTIFICATE_PASSWORD=

# App Store Connect API key, for notarytool.
# @tag(release)
ASC_API_KEY_P8_BASE64=
# @tag(release) @sensitive=false
ASC_KEY_ID=
# @tag(release) @sensitive=false
ASC_ISSUER_ID=

# Sparkle 2 EdDSA private key (base64 32-byte seed), piped to sign_update.
# @tag(release)
SPARKLE_PRIVATE_KEY=

# The Google OAuth client secret of "DirBuff for Mac" (project fishball-dirbuff), which Backup signs
# in to Drive with. Google treats a desktop client's secret as public; it lives here so the source
# doesn't carry it.
GOOGLE_OAUTH_CLIENT_SECRET=
